# Ignore git
.git
.gitignore
.gitattributes

# Ignore IDE files
.idea
*.iml
.vscode
.project
.classpath
.settings
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Ignore build artifacts: the JVM image builds inside the container. The one exception is
# the native executable, which src/main/docker/Dockerfile.native* package from the host
# build (a compile inside the image would need the Mandrel builder as a build stage).
target/*
!target/*-runner

# Ignore npm packaging and the Node side (not needed for either image)
npm
node_modules
bin
package.json
*.js

# Ignore docs, scripts and CI
*.md
docs
LICENSE
scripts
Makefile
.github
.gitlab-ci.yml

# Local development files
.env.local
.env.development
.env.test
*.log
*.tmp
