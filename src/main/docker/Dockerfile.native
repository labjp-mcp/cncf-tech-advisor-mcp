####
# CNCF Tech Advisor MCP Server - native executable on UBI minimal.
#
# The binary is compiled on the host (or in CI) first; this image only packages it. Keeping
# the compile outside the image is what lets the same build feed the JVM tests, the native
# parity check (scripts/mcp-native-parity.sh) and both native images from one compilation.
#
#   ./mvnw package -Pnative -DskipTests
#   docker build -f src/main/docker/Dockerfile.native -t cncf-tech-advisor-mcp:native .
#   docker run -i --rm -p 127.0.0.1:8080:8080 cncf-tech-advisor-mcp:native
#
# Without a local GraalVM or Mandrel, compile inside the builder container instead:
#   ./mvnw package -Pnative -DskipTests -Dquarkus.native.container-build=true
# Quarkus 3.33 pulls quay.io/quarkus/ubi9-quarkus-mandrel-builder-image:jdk-25 for that.
#
# The port is published on loopback in the example on purpose: this image binds 0.0.0.0
# and carries no authentication of its own (the CNCF Landscape data is public, but the
# endpoint is still an unauthenticated tool surface). Put a network boundary in front of it.
#
# Pinned to a UBI 9 minor rather than the floating `latest`: a rebuild then packages the
# binary on the same userland it was scanned against. Bump it deliberately.
####
FROM registry.access.redhat.com/ubi9/ubi-minimal:9.8

LABEL io.modelcontextprotocol.server.name="io.github.labjp-mcp/cncf-tech-advisor-mcp"
LABEL io.k8s.display-name="CNCF Tech Advisor MCP Server (native)"
LABEL io.openshift.tags="mcp,cncf,kubernetes,landscape,technology-advisor,quarkus,native"
LABEL maintainer="Jean Lopez"
LABEL description="MCP Server for CNCF Landscape Technology Data (native executable)"

WORKDIR /work/
RUN chown 1001 /work \
    && chmod "g+rwX" /work \
    && chown 1001:root /work

COPY --chown=1001:root --chmod=0755 target/*-runner /work/application

EXPOSE 8080
USER 1001

# A container serves the HTTP transport: the port must be reachable from outside the
# network namespace, and stdio (the default for a locally launched process) is switched
# off because nothing is attached to the container's stdin. Both are runtime properties,
# so a `docker run -e` override still wins.
ENV QUARKUS_HTTP_HOST=0.0.0.0 \
    QUARKUS_HTTP_PORT=8080 \
    QUARKUS_HTTP_HOST_ENABLED=true \
    QUARKUS_MCP_SERVER_STDIO_ENABLED=false

# No HEALTHCHECK on purpose. Kubernetes ignores the instruction and the orchestrator's
# probes are the ones that matter; a curl-based check here would only add a dependency
# on a binary the micro variant does not even have.
ENTRYPOINT ["./application"]
